# All optional — these are the defaults.
LOG_LEVEL=info

# Which harness runs the steps: claude | codex | copilot | agy. `--harness` overrides it for one
# run; `resume` goes on with the harness recorded in state.json unless `--harness` is given.
PIPELINE_HARNESS=claude

# The binaries, when they are not on PATH under their own names.
CLAUDE_BIN=claude
CODEX_BIN=codex
COPILOT_BIN=copilot
AGY_BIN=agy

# How a headless step answers permission prompts — one setting, mapped per harness. Steps write
# files and run builds, so the default, bypassPermissions, starts every step with the harness's
# skip-everything flag (claude/agy --dangerously-skip-permissions, codex
# --dangerously-bypass-approvals-and-sandbox, copilot --allow-all).
#   acceptEdits  claude --permission-mode acceptEdits · codex -s workspace-write ·
#                copilot --allow-tool=write · agy --mode accept-edits
#   plan         claude --permission-mode plan · codex -s read-only ·
#                copilot --allow-all-tools --deny-tool=write --deny-tool=shell · agy --mode plan
#   auto, manual, dontAsk   Claude only. Any other harness refuses them before the run starts.
# CLAUDE_PERMISSION_MODE is the older name of this setting and is still read.
PIPELINE_PERMISSION_MODE=bypassPermissions

# One step may run this long before it is killed and recorded as failed.
STEP_TIMEOUT_MINUTES=90

# `model` in pipeline.json (fable | opus | sonnet | haiku) is a tier. These say which model a tier
# means on each harness, as tier=model pairs. Empty by default: an unmapped tier passes no model
# flag and the harness default runs (one warning at load). On Claude a tier is its own alias.
# List ids with: `agy models`, `copilot help config`, `codex` → /model.
CLAUDE_MODELS=
CODEX_MODELS=
COPILOT_MODELS=
AGY_MODELS=
# Example:
# CODEX_MODELS=fable=gpt-6-astra,opus=gpt-6-astra,sonnet=gpt-5.6-terra,haiku=gpt-5.6-luna

# The model for a step that names none (`--default-model` overrides it). Unset: the harness
# default runs — which may be its most expensive one.
# PIPELINE_DEFAULT_MODEL=haiku

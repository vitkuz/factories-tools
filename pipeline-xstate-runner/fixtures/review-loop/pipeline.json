{
  "id": "review-loop",
  "description": "draft → review; REVISE loops back at most 2 times, then onMax → polish → END",
  "constants": { "rootPath": "cwd", "skillPath": ".", "homePath": "~" },
  "params": { "topic": "demo" },
  "outputDir": "{{rootPath}}/run/{{id}}/{{slug}}-{{date}}",
  "START": ["draft"],
  "steps": {
    "draft": {
      "agent": "general-purpose",
      "prompt": ["Draft {{topic}}."],
      "output": ["1-draft/draft.md"],
      "transitions": { "DONE": { "target": ["review"] } }
    },
    "review": {
      "agent": "general-purpose",
      "prompt": ["Review."],
      "input": ["1-draft/draft.md"],
      "output": ["2-review/review.md"],
      "transitions": {
        "APPROVE": { "target": ["END"] },
        "REVISE": { "target": ["draft"], "max": 2, "onMax": ["polish"] }
      }
    },
    "polish": {
      "agent": "general-purpose",
      "prompt": ["Polish."],
      "output": ["3-polish/final.md"],
      "transitions": { "DONE": { "target": ["END"] } }
    }
  }
}

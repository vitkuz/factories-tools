# Copy to api/.env for local runs. Every variable has a default; nothing has to be set.

# TCP port the API listens on. 3150 keeps clear of the other local APIs (3100-3103, 3200).
PORT=3150

# Interface to bind. Loopback unless set on purpose: the API writes pipeline files and skills.
HOST=127.0.0.1

# Where factories/, factories.local/, .claude/skills/, knowledge/ and scripts/ live. Defaults to
# the repository root two levels above factories-tools/factory-editor.
# WORK_DIR=/path/to/project

# winston level: error | warn | info | debug
LOG_LEVEL=info

# Optional. When set (16+ characters) every /api/v1 route needs a matching x-api-key header.
# API_KEY=

# The built app the API serves at /. Defaults to factories-tools/factory-editor/web/dist.
# WEB_DIST=/path/to/project/factories-tools/factory-editor/web/dist

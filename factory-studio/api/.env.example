# Copy to api/.env for local runs. Every variable has a default; nothing has to be set.

# TCP port the API listens on.
PORT=3100

# Interface to bind. Loopback unless set on purpose: the harness it starts skips every approval prompt.
HOST=127.0.0.1

# Where .claude/skills/, run/ and knowledge/ live and where harnesses start. Defaults to the
# repository root two levels above factories-tools/factory-studio.
# WORK_DIR=/path/to/project

# Where <session>.prompt files are written (directory 0700, files 0600).
# PROMPT_DIR=/tmp/factory-studio

# The tmux binary.
TMUX_BIN=/usr/bin/tmux

# How long a new session must stay alive (ms) before a start counts as started.
START_GRACE_MS=750

# winston level: error | warn | info | debug
LOG_LEVEL=info

# Optional. When set (16+ characters) every /api/v1 route needs a matching x-api-key header.
# API_KEY=

# The built app the API serves at /. Defaults to factories-tools/factory-studio/web/dist.
# WEB_DIST=/path/to/project/factories-tools/factory-studio/web/dist

{
  "name": "@factory-studio/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Factory Studio app: the pipeline editor, the runs dashboard and the sessions screen in one static React app, served by the Factory Studio API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" vite.config.ts index.html",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" vite.config.ts index.html"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@xyflow/react": "^12.11.6",
    "axios": "^1.7.9",
    "html-to-image": "^1.11.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.1.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^11.0.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
